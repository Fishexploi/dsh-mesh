{
  "name": "@fishboy/dsh-mesh",
  "version": "0.4.5",
  "private": false,
  "description": "Connect DSH hosts on a LAN and delegate tasks between parent and child nodes.",
  "type": "module",
  "main": "index.js",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "multi-host",
    "mesh",
    "delegation",
    "lan"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  },
  "engines": {
    "dsh": "^0.2.2-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fishexploi/dsh-mesh.git"
  },
  "homepage": "https://github.com/Fishexploi/dsh-mesh",
  "bugs": {
    "url": "https://github.com/Fishexploi/dsh-mesh/issues"
  },
  "license": "MIT"
}
